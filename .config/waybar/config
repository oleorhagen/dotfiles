{
    // "layer": "top", // Waybar at top layer
    // "position": "bottom", // Waybar position (top|bottom|left|right)
    "spacing": 4,
    // Choose the order of the modules
    "modules-left": [
        "custom/logo",

        "sway/mode",
        "pulseaudio#icon",
        "pulseaudio#sound",
        "backlight#icon",
        "backlight#value",
        "custom/icon-cube",
    ],
    "modules-center": ["sway/workspaces", "sway/window"],
    "modules-right": [
    "custom/displays",
    "custom/hackeriet",
    "custom/vpn",
    "network",
    "cpu",
    "memory",
    "temperature",
    "battery",
    "clock",
    "tray"
    ],
    "sway/mode": {
        "format": "<span style=\"italic\">{}</span>"
    },
    "sway/window": {
        "format": "{}",
        "max-length": 50,
        "rewrite": {
            "(.*) - Mozilla Firefox": "🌐 $1",
        }
    },
    "idle_inhibitor": {
        "format": "{icon}",
        "format-icons": {
            "activated": "",
            "deactivated": ""
        }
    },
    "tray": {
        "icon-size": 21,
        "spacing": 10
    },
    "clock": {
        // "timezone": "America/New_York",
        "format": " {:%H:%M}",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
        "format-alt": " {:%Y-%m-%d}"
    },
    "cpu": {
        "format": " {usage}%",
        "tooltip": true,
        "tooltip-format": "Load average: {load}",
        "interval": 5,
        "on-click": "alacritty -e htop"
    },
    "memory": {
        "format": " {percentage}%",
        "tooltip-format": "{used:0.1f}GiB / {total:0.1f}GiB used",
        "interval": 5
    },
    "temperature": {
        "thermal-zone": 10,
        "critical-threshold": 85,
        "format": "{icon} {temperatureC}°C",
        "format-icons": ["", "", ""]
    },
    "backlight#icon": {
        // "device": "acpi_video1",
        "format": "{icon}",
        "format-icons": ["", ""],
        "on-click": "ctl-backlight.waybar.sh down"
    },
    "backlight#value": {
        // "device": "acpi_video1",
        "format": "{percent}",
        "on-click": "ctl-backlight.waybar.sh up"
    },
    "battery": {
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "{icon} {capacity}%",
        "format-charging": " {capacity}%",
        "format-plugged": " {capacity}%",
        "format-alt": "{icon} {time}",
        "format-icons": ["", "", "", "", ""],
        "tooltip-format": "{timeTo}, {power} W"
    },
    "network": {
        // "interface": "wlp2*", // (Optional) To force the use of this interface
        "format-wifi": "{icon} {essid}",
        "format-ethernet": " {ipaddr}/{cidr}",
        "format-linked": " {ifname} (No IP)",
        "format-disconnected": "󰤮 Offline",
        "format-alt": "{icon} {signalStrength}%",
        "format-icons": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"],
        "tooltip-format-wifi": "{essid} ({signalStrength}%)\n{ipaddr}/{cidr}",
        "tooltip-format-ethernet": "{ifname}: {ipaddr}/{cidr}",
        "tooltip-format-disconnected": "Disconnected",
        "on-click": "alacritty -e nmtui",
        "interval": 5
    },
    "pulseaudio#sound": {
        "format": "{volume}",
        "format-icons": {
            "headphone": "",
            "hands-free": "",
            "headset": "",
            "phone": "",
            "portable": "",
            "car": "",
            "default": ["", "", ""]
        },
    },
    "pulseaudio#icon": {
        // "scroll-step": 1, // %, can be a float
        "format": "{icon}",
        "format-bluetooth": "{icon}",
        "format-bluetooth-muted": " {icon}",
        "format-muted": "",
        "format-source-muted": "",
        "on-click": "pactl set-sink-mute 0 toggle",
        "format-icons": {
            "headphone": "",
            "hands-free": "",
            "headset": "",
            "phone": "",
            "portable": "",
            "car": "",
            "default": ["", "", ""]
        },
    },
    "custom/media": {
        "format": "{icon} {}",
        "return-type": "json",
        "max-length": 40,
        "format-icons": {
            "spotify": "",
            "default": "🎜"
        },
        "escape": true,
        "exec": "$HOME/.config/waybar/mediaplayer.py 2> /dev/null" // Script in resources folder
        // "exec": "$HOME/.config/waybar/mediaplayer.py --player spotify 2> /dev/null" // Filter player based on name
  },

    "custom/logo": {
        "format": ""
  },

 // "custom/emailicon": {
 //     "format": ""
 // },

 // "custom/unreademail": {
 //     "format": "{}",
 //     "exec": "cat /tmp/unread-email-count.txt || echo ErrNF",
 //     "signal": 2,
 //     "interval": 10,
 // },

  "custom/icon-cube": {
      "format": ""
  },


  "custom/vpn": {
      "format": "VPN: {icon}",
      "exec": "$HOME/.files/scripts/waybar-vpn-active",
      // "on-click": "$HOME/.files/scripts/waybar-vpn-active",
      "return-type": "json",
      "interval": 10,
      "format-icons": [ "󰦞", "󰦝" ]
      // "on-click": "/bin/ls"
  },

  //  {"text": "$text", "alt": "$alt", "tooltip": "$tooltip", "class": "$class", "percentage": $percentage }
  "custom/hackeriet": {
      "format": "Hackeriet: {}",
      "exec": "curl  -q -L hackeriet.no/door.json 2>/dev/null | sed 's/status/text/' | jq --unbuffered --compact-output",
      "return-type": "json",
      "interval": 60
  },


  "custom/displays": {
      "format": "󰨇",
      "on-click": "wdisplays"
  }
}
